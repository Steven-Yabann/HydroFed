FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HYDROFED_DB_PATH=/data/experiments.db

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir . \
    && useradd --create-home --shell /bin/sh --uid 10001 hydrofed \
    && mkdir -p /data /home/hydrofed/.ssh \
    && chown -R hydrofed:hydrofed /data /home/hydrofed/.ssh \
    && chmod 0700 /home/hydrofed/.ssh

USER hydrofed

EXPOSE 8000

CMD ["sh", "-c", "uvicorn hydrofed.api:create_app --factory --host 0.0.0.0 --port ${PORT:-8000}"]
