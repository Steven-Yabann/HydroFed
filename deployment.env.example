HYDROFED_PORT=8080
HYDROFED_ALLOWED_ORIGINS=http://localhost:8080
HYDROFED_FRONTEND_URL=http://localhost:8080
HYDROFED_PUBLIC_API_URL=http://localhost:8080
HYDROFED_SECRET_KEY=change-me-to-a-long-random-string

# First administrator, created on an empty database only. Leave the password
# empty to sign in with Google or Microsoft instead.
HYDROFED_ADMIN_EMAIL=
