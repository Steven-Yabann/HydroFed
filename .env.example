HYDROFED_DB_PATH=artifacts/experiments.db
HYDROFED_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Signs session tokens. Without it, a random key is kept next to the database.
HYDROFED_SECRET_KEY=
# Where the dashboard and API are reached, for single sign-on redirects.
HYDROFED_FRONTEND_URL=http://localhost:5173
HYDROFED_PUBLIC_API_URL=http://localhost:8000
# Optional single sign-on. Register the redirect URI
# <HYDROFED_PUBLIC_API_URL>/api/auth/oauth/<google|microsoft>/callback with the provider.
HYDROFED_GOOGLE_CLIENT_ID=
HYDROFED_GOOGLE_CLIENT_SECRET=
HYDROFED_MICROSOFT_CLIENT_ID=
HYDROFED_MICROSOFT_CLIENT_SECRET=
HYDROFED_MICROSOFT_TENANT=organizations
# Data the dashboard reads.
HYDROFED_FEED_PATH=artifacts/operator
HYDROFED_COMPARISON_PATH=artifacts/comparison
# Set to 0 to stop administrators starting training runs from the dashboard.
HYDROFED_ALLOW_TRAINING=1
